# ~/.bash.aliases - Modernized & Hardened

# Quick tar compress/decompress with progress
alias qcompress='tar -cvzf'
alias qdecompress='tar -xvzf'

# --- Shell & Navigation ---
alias refresh='source ~/.bashrc'
alias path='echo "$PATH" | tr ":" "\n"'
alias da='date "+%Y-%m-%d %A %T %Z"'
alias +x='chmod +x'

# Allow sudo to expand aliases (e.g., 'sudo ll')
alias sudo='sudo '

# File listing (Uses eza/lsd if available; fallback to enhanced ls)
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --icons=auto'
    alias ll='eza -lhF --git --group-directories-first'
    alias la='eza -lahF --git --group-directories-first'
    alias l='eza -CF'
    alias lt='eza -lhF -s=size --group-directories-first'
    alias tree='eza --tree --icons=auto'
elif command -v lsd >/dev/null 2>&1; then
    alias ls='lsd'
    alias ll='lsd -l'
    alias la='lsd -a'
    alias l='lsd -CF'
    alias lt='lsd -l --total-size'
    alias tree='lsd --tree'
else
    alias ls='ls --color=auto'
    alias ll='ls -lahF --group-directories-first'
    alias la='ls -A'
    alias l='ls -CF'
    alias lt='ls -lhS --group-directories-first'
    alias tree='tree -CAhF --dirsfirst'
    alias treed='tree -CAFd'
fi

# Verbose directory and temp creation
alias mkdir='mkdir -pv'
alias mktemp='mktemp -dv'

# --- External Tools (Bat / FZF / Kitty) ---
# Transparent compatibility for bat / batcat
if command -v batcat >/dev/null 2>&1; then
    alias bat='batcat'
    _BAT_CMD="batcat"
elif command -v bat >/dev/null 2>&1; then
    _BAT_CMD="bat"
fi

if [ -n "${_BAT_CMD:-}" ]; then
    alias fzf="fzf --preview '$_BAT_CMD --style=numbers --color=always --line-range :500 {}'"
fi

alias icat='kitty +kitten icat'

# --- Networking & Ports (Modern netstat replacement) ---
alias openports='ss -tulpn'
alias lsockets='sudo ss -tulpn | grep LISTEN'
alias listen='ss -tulnp'
alias netcon="ss -ntu | awk '{print \$5}' | cut -d: -f1 | sort | uniq -c | sort -nr"
alias myip="curl -s https://ifconfig.me; echo ''; ip -brief -4 address"
alias curltime='curl -o /dev/null -s -w "Connect: %{time_connect}s\nTTFB: %{time_starttransfer}s\nTotal: %{time_total}s\nStatus: %{http_code}\n"'

# User-Agent Helpers
alias nmaph='nmap --script-args http.useragent="$CHROME_DESKTOP_AGENT"'
alias wpscanh='wpscan --ua "$FIREFOX_DESKTOP_AGENT"'
alias curlh='curl -A "$EDGE_DESKTOP_AGENT"'
alias wgeth='wget -U "$ANDROID_MOBILE_AGENT"'

# --- Hardware, Disk & Processes ---
alias topcpu="ps aux --sort=-%cpu | head -n 11"
alias topmem="ps aux --sort=-%mem | head -n 11"
alias devices="lsblk -f"
alias devicess="lshw -short"
alias cpuinfo="less /proc/cpuinfo"
alias meminfo='free -h'

# df/du replacement if duf is available
if command -v duf >/dev/null 2>&1; then
    alias mountedinfo='duf'
else
    alias mountedinfo='df -hT'
fi

alias mnt='findmnt -t ext4,btrfs,xfs,zfs,ntfs,vfat'
alias folders='du -h --max-depth=1 | sort -hr'
alias folderssort='du -sh ./* 2>/dev/null | sort -hr'
alias usage='du -ch | grep total'
alias totalusage='df -hl --total | grep total'

# --- File Operations & Cleanup ---
alias count='find . -type f | wc -l'

# cpv /ruta/archivo_grande.iso /media/usb/
# cpv -r carpeta_origen/ /media/backup/
alias cpv='rsync -ah --info=progress2'
alias rsync-copy='rsync -aHAXvh --info=progress2'
alias rsync-move='rsync -aHAXvh --remove-source-files --info=progress2'
alias rsync-update='rsync -uavh --info=progress2'
alias rsync-mirror='rsync -aHAXvh --delete --info=progress2'

# Backup web root or database dumps fast
alias mirror-site='rsync -aHAXZvh --exclude=".git" --delete --info=progress2'

alias shredd='shred -uzv -n 10'
alias dropcache='sudo sync; echo 3 | sudo tee /proc/sys/vm/drop_caches'

# Package manager updates mapped by system type
if command -v apt >/dev/null 2>&1; then
    alias update='sudo apt update && sudo apt upgrade'
    alias cleanapt='sudo apt clean && sudo apt autoremove --purge -y'
elif command -v pacman >/dev/null 2>&1; then
    alias update='sudo pacman -Syu'
    alias cleanpacman='sudo pacman -Scc'
fi

alias cachefonts='fc-cache -f -v'
alias logs="journalctl -xf"
alias journalerr='journalctl -p 3 -xb'

# --- Systemd ---
alias failed='systemctl --failed'
alias ufailed='systemctl --user --failed'
alias failedlogins='sudo journalctl -u sshd -u systemd-logind | grep -i "failed"'

# --- Long-running command alerts ---
# sudo apt update && sudo apt upgrade -y; alert
# sleep 30; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# --- ARCH LINUX SPECIFICS ---
alias pacorphans='sudo pacman -Rns $(pacman -Qtdq)'
alias unlockpacman='sudo rm /var/lib/pacman/db.lck'
# Find .pacnew or .pacsave files after updates
alias pacdiff-check='pacman -Qii | awk '\''/^(Name|Backup)/{if ($1=="Name") name=$3; else if ($2 ~ /\[modified\]/) print name, $2}'\'''