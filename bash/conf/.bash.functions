# ~/.bash.functions - portable developer and sysadmin helpers.

_dot_has() { command -v "$1" >/dev/null 2>&1; }

_copy_to_clipboard() {
    if _dot_has wl-copy; then
        wl-copy
    elif _dot_has xclip; then
        xclip -selection clipboard
    elif _dot_has xsel; then
        xsel --clipboard --input
    else
        printf 'No clipboard provider found (wl-copy/xclip/xsel).\n' >&2
        return 1
    fi
}

extract() {
    (($#)) || { printf 'Usage: extract <archive> [...]\n' >&2; return 2; }
    local archive rc=0
    for archive in "$@"; do
        [[ -f "$archive" ]] || { printf 'Not a file: %s\n' "$archive" >&2; rc=1; continue; }
        case "${archive,,}" in
            *.tar.gz|*.tgz) tar -xzf "$archive" || rc=1 ;;
            *.tar.bz2|*.tbz2) tar -xjf "$archive" || rc=1 ;;
            *.tar.xz|*.txz) tar -xJf "$archive" || rc=1 ;;
            *.tar.zst) tar --zstd -xf "$archive" || rc=1 ;;
            *.tar) tar -xf "$archive" || rc=1 ;;
            *.zip) _dot_has unzip && unzip "$archive" || rc=1 ;;
            *.7z) _dot_has 7z && 7z x "$archive" || rc=1 ;;
            *.rar) _dot_has unrar && unrar x "$archive" || rc=1 ;;
            *.gz) gzip -dk "$archive" || rc=1 ;;
            *.bz2) bzip2 -dk "$archive" || rc=1 ;;
            *.xz) xz -dk "$archive" || rc=1 ;;
            *.zst) _dot_has zstd && zstd -d "$archive" || rc=1 ;;
            *) printf 'Unsupported archive: %s\n' "$archive" >&2; rc=1 ;;
        esac
    done
    return "$rc"
}

backup() {
    (($# == 1)) || { printf 'Usage: backup <path>\n' >&2; return 2; }
    [[ -e "$1" || -L "$1" ]] || { printf 'Path not found: %s\n' "$1" >&2; return 1; }
    local dst="${1%/}.bak.$(date +%Y%m%d-%H%M%S)"
    cp -a -- "$1" "$dst" && printf 'Backup: %s\n' "$dst"
}

mkcd() {
    (($# == 1)) || { printf 'Usage: mkcd <directory>\n' >&2; return 2; }
    mkdir -p -- "$1" && cd -- "$1" || return
}

up() {
    local n="${1:-1}" path="" i
    [[ "$n" =~ ^[1-9][0-9]*$ ]] || { printf 'Usage: up [positive-integer]\n' >&2; return 2; }
    for ((i=0; i<n; i++)); do path+="../"; done
    cd -- "$path" || return
}

gitroot() {
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || { printf 'Not inside a Git worktree.\n' >&2; return 1; }
    cd -- "$root" || return
}

ftext() {
    (($#)) || { printf 'Usage: ftext <pattern> [path]\n' >&2; return 2; }
    local pattern="$1" path="${2:-.}"
    if _dot_has rg; then
        rg --smart-case --line-number --heading --color=always -- "$pattern" "$path" | ${PAGER:-less} -R
    else
        grep -RIn --color=always --exclude-dir=.git -- "$pattern" "$path" | ${PAGER:-less} -R
    fi
}

tre() {
    if _dot_has eza; then
        eza --tree --group-directories-first --ignore-glob='.git' "$@" | ${PAGER:-less} -FRX
    elif _dot_has tree; then
        tree -aC -I .git --dirsfirst "$@" | ${PAGER:-less} -FRX
    else
        find "${1:-.}" -maxdepth "${2:-2}" -print | ${PAGER:-less} -FRX
    fi
}

topaste() {
    (($# == 1)) || { printf 'Usage: topaste <file>\n' >&2; return 2; }
    [[ -f "$1" ]] || { printf 'File not found: %s\n' "$1" >&2; return 1; }
    _copy_to_clipboard <"$1" && printf 'Copied %s to clipboard.\n' "$1"
}

dataurl() {
    (($# == 1)) || { printf 'Usage: dataurl <file>\n' >&2; return 2; }
    [[ -f "$1" ]] || return 1
    local mime b64
    mime="$(_dot_has file && file -b --mime-type "$1" || printf application/octet-stream)"
    if _dot_has base64; then
        b64="$(base64 "$1" | tr -d '\r\n')" || return 1
    elif _dot_has openssl; then
        b64="$(openssl base64 -A -in "$1")" || return 1
    else
        printf 'base64 or openssl is required.\n' >&2; return 1
    fi
    printf 'data:%s;base64,%s\n' "$mime" "$b64"
}

digg() {
    (($#)) || { printf 'Usage: digg <name> [type]\n' >&2; return 2; }
    _dot_has dig || { printf 'dig is not installed.\n' >&2; return 1; }
    dig +noall +answer "$1" "${2:-A}"
}

myip() {
    printf 'Local addresses:\n'
    ip -brief address 2>/dev/null || hostname -I 2>/dev/null || true
    printf '\nPublic address:\n'
    local url value=""
    for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
        value="$(curl -fsS --connect-timeout 2 --max-time 4 "$url" 2>/dev/null || true)"
        [[ "$value" =~ ^[0-9A-Fa-f:.]+$ ]] && { printf '%s\n' "$value"; return 0; }
    done
    printf 'Unavailable.\n' >&2
    return 1
}

serve() {
    local bind="127.0.0.1" port="8000"
    while (($#)); do
        case "$1" in
            --public) bind="0.0.0.0" ;;
            -b|--bind) [[ $# -ge 2 ]] || { printf 'Missing bind address.\n' >&2; return 2; }; bind="$2"; shift ;;
            -p|--port) [[ $# -ge 2 ]] || { printf 'Missing port.\n' >&2; return 2; }; port="$2"; shift ;;
            -h|--help) printf 'Usage: serve [--public] [--bind ADDRESS] [--port PORT]\n'; return 0 ;;
            *) port="$1" ;;
        esac
        shift
    done
    [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || { printf 'Invalid port.\n' >&2; return 2; }
    printf 'Serving %s:%s from %s\n' "$bind" "$port" "$PWD"
    if _dot_has python3; then
        python3 -m http.server --bind "$bind" "$port"
    elif _dot_has php; then
        php -S "$bind:$port"
    else
        printf 'python3 or php is required.\n' >&2; return 1
    fi
}

fkill() {
    _dot_has fzf || { printf 'fzf is required.\n' >&2; return 1; }
    local signal="TERM"
    [[ "${1:-}" == "--force" ]] && { signal="KILL"; shift; }
    local pids
    pids="$(ps -eo pid,user,stat,etimes,command --sort=-etimes | sed 1d | fzf -m --header="Select process(es); signal=$signal" | awk '{print $1}')"
    [[ -n "$pids" ]] || return 0
    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] && kill -s "$signal" "$pid"
    done <<<"$pids"
}

genpass() {
    local length="${1:-24}"
    [[ "$length" =~ ^[0-9]+$ ]] && (( length >= 8 && length <= 256 )) || { printf 'Usage: genpass [8-256]\n' >&2; return 2; }
    _dot_has openssl || { printf 'openssl is required.\n' >&2; return 1; }
    # Hex avoids SIGPIPE-prone filtering pipelines and remains cryptographically random.
    local bytes=$(( (length + 1) / 2 )) out
    out="$(openssl rand -hex "$bytes")" || return 1
    printf '%s\n' "${out:0:length}"
}

genpassphrase() {
    local count="${1:-4}" sep="${2:--}" dict=""
    [[ "$count" =~ ^[1-9][0-9]*$ ]] || { printf 'Usage: genpassphrase [count] [separator]\n' >&2; return 2; }
    for dict in /usr/share/dict/words /usr/share/dict/american-english /usr/share/dict/spanish; do
        [[ -r "$dict" ]] && break
    done
    [[ -r "$dict" ]] || { printf 'No system word list found.\n' >&2; return 1; }
    awk 'length($0)>=4 && length($0)<=9 && $0 ~ /^[[:alpha:]]+$/ {print tolower($0)}' "$dict" |
        shuf -n "$count" | paste -sd "$sep" -
}

mkvenv() {
    local dir="${1:-.venv}"
    _dot_has python3 || { printf 'python3 is required.\n' >&2; return 1; }
    python3 -m venv "$dir" || return 1
    # shellcheck disable=SC1090
    . "$dir/bin/activate"
}

retry() {
    local attempts="${1:-3}" delay="${2:-2}"
    shift 2 2>/dev/null || true
    (($#)) || { printf 'Usage: retry <attempts> <delay-seconds> command ...\n' >&2; return 2; }
    local i rc=0
    for ((i=1; i<=attempts; i++)); do
        "$@" && return 0
        rc=$?
        (( i < attempts )) && sleep "$delay"
    done
    return "$rc"
}

sysupdate() {
    if _dot_has apt-get; then
        sudo apt-get update && sudo apt-get upgrade
    elif _dot_has dnf; then
        sudo dnf upgrade --refresh
    elif _dot_has pacman; then
        sudo pacman -Syu
    elif _dot_has zypper; then
        local os_id=""
        if [[ -r /etc/os-release ]]; then
            os_id="$(. /etc/os-release; printf '%s' "${ID:-}")"
        fi
        if [[ "$os_id" == "opensuse-tumbleweed" || "$os_id" == "opensuse-microos" ]]; then
            sudo zypper refresh && sudo zypper dup
        else
            sudo zypper refresh && sudo zypper update
        fi
    else
        printf 'No supported package manager found.\n' >&2
        return 1
    fi
}
