# Managed portable Git defaults.
# User identity is intentionally absent; keep it in ~/.config/git/local.gitconfig
# or configure it with `git config --global user.name/user.email`.

[core]
    autocrlf = input
    quotePath = false

[init]
    defaultBranch = main

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true
    renames = true

[merge]
    conflictStyle = zdiff3

[push]
    autoSetupRemote = true
    followTags = true
    default = simple

[fetch]
    prune = true
    writeCommitGraph = true
    fsckObjects = true

[transfer]
    fsckObjects = true

[receive]
    fsckObjects = true

[pull]
    rebase = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[help]
    autocorrect = prompt

[include]
    path = ~/.config/git/local.gitconfig
