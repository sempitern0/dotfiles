# Portable OpenSSH client defaults managed by the dotfiles assistant.
# Personal IdentityFile, ProxyJump and host aliases belong in separate files
# under ~/.ssh/conf.d/ so this template never assumes a private-key name.

Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    AddKeysToAgent yes
    ForwardAgent no
    HashKnownHosts yes
    UpdateHostKeys ask

Host github.com gitlab.com
    User git
    PreferredAuthentications publickey
