Host me.github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    AddKeysToAgent yes

    ServerAliveInterval 60
    ServerAliveCountMax 5
    HostKeyAlgorithms ssh-ed25519,ecdsa-sha2-nistp256
    
    IgnoreUnknown UseKeychain
    UseKeychain yes